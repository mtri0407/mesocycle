# Copy this file to .dev.vars and put your real keys there.
# .dev.vars is in .gitignore, so it never reaches GitHub.

# Meta Model API key (dev.meta.ai > API keys)
MODEL_API_KEY=

# Baseten key for Muse Spark Open (hackathon credits)
BASETEN_API_KEY=

# Which model the agent uses: "meta" (muse-spark-1.3) or "open" (Muse Spark Open on Baseten)
MODEL_PROVIDER=meta
